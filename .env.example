# docker compose 环境变量模板：复制为 .env 后按需修改（compose 会自动读取同目录 .env）
# 注意：本地开发（不用 Docker）请复制 backend/.env.example → backend/.env，并在那里配置本机 MySQL。
# 本文件里的密码只是占位符，务必改成自己的强密码，且不要把真实 .env 提交到仓库。
APP_NAME=Admin Panel API
APP_VERSION=2.1.0

# 运行环境：dev / prod（prod 会关闭 Swagger、停止灌演示数据、强制校验 SECRET_KEY）
APP_ENV=dev

# JWT：生产必须换成随机值，例如 `openssl rand -hex 32`
SECRET_KEY=please-change-this-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

# MySQL（compose 在容器网络内连接 mysql:3306；宿主机映射 127.0.0.1:3307）
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=admin
MYSQL_PASSWORD=change-me
MYSQL_DB=admin_panel

# 验证码开关（本地联调可设为 false，前端会自动隐藏验证码输入框）
CAPTCHA_ENABLED=true

# 密码强度：最小长度 / 至少包含几类字符（小写、大写、数字、符号）
PASSWORD_MIN_LEN=8
PASSWORD_MIN_CLASSES=2

# 连续登录失败锁定
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=10

# 文件上传上限（MB）
MAX_UPLOAD_MB=10

# 接口限流开关（压测时可关闭）
RATE_LIMIT_ENABLED=true

# 日志：text / json（容器化建议 json）
LOG_LEVEL=INFO
LOG_FORMAT=json

# 可观测性：/metrics 是否开启
METRICS_ENABLED=true

# 种子数据：生产建议 SEED_DEMO_DATA=false；ADMIN_INITIAL_PASSWORD 只在首次启动建 admin 时使用
SEED_BASE_DATA=true
SEED_DEMO_DATA=true
ADMIN_INITIAL_PASSWORD=

# 后端 worker 数（建议 = CPU 核数，1 核机器设 1）
WEB_CONCURRENCY=2

# 跨域（生产建议改成具体域名，如 https://your-domain.com）
CORS_ORIGINS=*
# 允许的 Host（生产建议写具体域名，多个用逗号分隔；* 表示不限制）
TRUSTED_HOSTS=*
# Redis 是否必需（多实例生产建议 true）
REDIS_REQUIRED=false

# 构建镜像源（国内默认清华/淘宝镜像；海外构建可改成官方源）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
