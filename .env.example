# 复制为 .env 后按需修改（docker compose 会自动读取同目录 .env）
APP_NAME=Admin Panel API

# JWT
SECRET_KEY=please-change-this-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

# MySQL
MYSQL_ROOT_PASSWORD=root123
MYSQL_USER=admin
MYSQL_PASSWORD=123456
MYSQL_DB=admin_panel

# 验证码开关（本地联调可设为 false）
CAPTCHA_ENABLED=true

# 跨域
CORS_ORIGINS=*
