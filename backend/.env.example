# 本地开发配置模板：复制为 backend/.env 后按自己的 MySQL 账号修改（.env 已被 git 忽略）
# 真实环境变量优先级高于本文件；docker compose 部署时由 compose 注入，不会读取本文件

# 本机独立 MySQL 8 实例（端口 3307，见 mysql/local-mysql.ps1；若用其他实例改成对应端口）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=admin
# 改成你本机 MySQL 的密码
MYSQL_PASSWORD=change-me
MYSQL_DB=admin_panel

# DB_URL 留空 = 使用上面的 MySQL 配置；只有要临时切回 SQLite 时才填，如 sqlite:///./local.db
DB_URL=

# 上传目录指向项目内
UPLOAD_DIR=./uploads

# 本机开发关闭图形验证码，登录更方便（前端会读取 /api/auth/captcha 自动隐藏输入框）
CAPTCHA_ENABLED=false
